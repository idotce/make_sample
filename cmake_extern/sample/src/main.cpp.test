#include <iostream>
#include <string>
#include <vector>

// OpenCV 头文件
#include <opencv2/opencv.hpp>
#include <opencv2/core.hpp>
#include <opencv2/imgproc.hpp>
#include <opencv2/highgui.hpp>

// libcurl 头文件
#include <curl/curl.h>

// jsoncpp 头文件
#include <json/json.h>

// libcurl 写回调函数
size_t WriteCallback(void* contents, size_t size, size_t nmemb, std::string* response) {
    size_t totalSize = size * nmemb;
    response->append((char*)contents, totalSize);
    return totalSize;
}

// 测试 OpenCV 功能
bool testOpenCV() {
    std::cout << "=== 测试 OpenCV ===" << std::endl;

    try {
        // 创建一个测试图像
        cv::Mat testImage(300, 400, CV_8UC3, cv::Scalar(100, 150, 200));

        // 画一些图形
        cv::rectangle(testImage, cv::Point(50, 50), cv::Point(150, 150), cv::Scalar(255, 0, 0), 2);
        cv::circle(testImage, cv::Point(200, 100), 30, cv::Scalar(0, 255, 0), -1);

        // 添加文字
        cv::putText(testImage, "OpenCV Test", cv::Point(80, 250),
                   cv::FONT_HERSHEY_SIMPLEX, 0.8, cv::Scalar(255, 255, 255), 2);

        std::cout << "图像尺寸: " << testImage.cols << "x" << testImage.rows << std::endl;
        std::cout << "通道数: " << testImage.channels() << std::endl;

        // 显示图像（如果有GUI支持）
        // cv::imshow("OpenCV Test", testImage);
        // cv::waitKey(1000);
        // cv::destroyAllWindows();

        std::cout << "OpenCV 测试成功!" << std::endl;
        return true;
    }
    catch (const std::exception& e) {
        std::cerr << "OpenCV 测试失败: " << e.what() << std::endl;
        return false;
    }
}

// 测试 libcurl 功能
bool testLibCurl() {
    std::cout << "\n=== 测试 libcurl ===" << std::endl;

    CURL* curl;
    CURLcode res;
    std::string response;

    curl = curl_easy_init();
    if(curl) {
        // 设置请求URL（使用一个测试API）
        curl_easy_setopt(curl, CURLOPT_URL, "http://httpbin.org/get");
        curl_easy_setopt(curl, CURLOPT_WRITEFUNCTION, WriteCallback);
        curl_easy_setopt(curl, CURLOPT_WRITEDATA, &response);
        curl_easy_setopt(curl, CURLOPT_TIMEOUT, 10L);
        curl_easy_setopt(curl, CURLOPT_USERAGENT, "ThreeLibrariesTest/1.0");

        // 执行请求
        res = curl_easy_perform(curl);

        if(res == CURLE_OK) {
            long response_code;
            curl_easy_getinfo(curl, CURLINFO_RESPONSE_CODE, &response_code);

            std::cout << "HTTP 状态码: " << response_code << std::endl;
            std::cout << "响应长度: " << response.length() << " 字节" << std::endl;
            std::cout << "libcurl 测试成功!" << std::endl;

            curl_easy_cleanup(curl);
            return true;
        } else {
            std::cerr << "libcurl 请求失败: " << curl_easy_strerror(res) << std::endl;
            curl_easy_cleanup(curl);
            return false;
        }
    } else {
        std::cerr << "无法初始化 libcurl" << std::endl;
        return false;
    }
}

// 测试 jsoncpp 功能
bool testJsonCpp() {
    std::cout << "\n=== 测试 jsoncpp ===" << std::endl;

    try {
        // 创建 JSON 对象
        Json::Value root;
        root["name"] = "Three Libraries Test";
        root["version"] = 1.0;
        root["enabled"] = true;

        // 添加数组
        Json::Value libraries;
        libraries.append("OpenCV");
        libraries.append("libcurl");
        libraries.append("jsoncpp");
        root["libraries"] = libraries;

        // 添加嵌套对象
        Json::Value author;
        author["name"] = "Developer";
        author["email"] = "dev@example.com";
        root["author"] = author;

        // 序列化为字符串
        Json::StreamWriterBuilder writer;
        std::string jsonString = Json::writeString(writer, root);

        std::cout << "生成的 JSON:" << std::endl;
        std::cout << jsonString << std::endl;

        // 解析 JSON 字符串
        Json::CharReaderBuilder reader;
        Json::Value parsedRoot;
        std::string errors;
        std::istringstream jsonStream(jsonString);

        if(Json::parseFromStream(reader, jsonStream, &parsedRoot, &errors)) {
            std::cout << "解析成功!" << std::endl;
            std::cout << "名称: " << parsedRoot["name"].asString() << std::endl;
            std::cout << "版本: " << parsedRoot["version"].asDouble() << std::endl;
            std::cout << "作者: " << parsedRoot["author"]["name"].asString() << std::endl;

            std::cout << "库列表:" << std::endl;
            for(const auto& lib : parsedRoot["libraries"]) {
                std::cout << "  - " << lib.asString() << std::endl;
            }

            std::cout << "jsoncpp 测试成功!" << std::endl;
            return true;
        } else {
            std::cerr << "JSON 解析失败: " << errors << std::endl;
            return false;
        }
    }
    catch (const std::exception& e) {
        std::cerr << "jsoncpp 测试失败: " << e.what() << std::endl;
        return false;
    }
}

// 综合测试：使用三个库完成一个复杂任务
bool integratedTest() {
    std::cout << "\n=== 综合测试 ===" << std::endl;

    try {
        // 使用 libcurl 获取 JSON 数据
        CURL* curl = curl_easy_init();
        std::string jsonResponse;

        if(curl) {
            curl_easy_setopt(curl, CURLOPT_URL, "http://httpbin.org/json");
            curl_easy_setopt(curl, CURLOPT_WRITEFUNCTION, WriteCallback);
            curl_easy_setopt(curl, CURLOPT_WRITEDATA, &jsonResponse);
            curl_easy_setopt(curl, CURLOPT_TIMEOUT, 10L);

            CURLcode res = curl_easy_perform(curl);
            curl_easy_cleanup(curl);

            if(res == CURLE_OK) {
                // 使用 jsoncpp 解析响应
                Json::CharReaderBuilder reader;
                Json::Value root;
                std::string errors;
                std::istringstream jsonStream(jsonResponse);

                if(Json::parseFromStream(reader, jsonStream, &root, &errors)) {
                    std::cout << "成功获取并解析 JSON 数据!" << std::endl;

                    // 使用 OpenCV 创建一个可视化结果
                    cv::Mat result(200, 600, CV_8UC3, cv::Scalar(240, 240, 240));
                    std::string successText = "所有库工作正常!";
                    cv::putText(result, successText, cv::Point(50, 100),
                               cv::FONT_HERSHEY_SIMPLEX, 1.0, cv::Scalar(0, 150, 0), 2);

                    std::cout << "综合测试成功完成!" << std::endl;
                    return true;
                }
            }
        }

        std::cerr << "综合测试失败" << std::endl;
        return false;
    }
    catch (const std::exception& e) {
        std::cerr << "综合测试异常: " << e.what() << std::endl;
        return false;
    }
}

int main() {
#ifdef _WIN32
    SetConsoleOutputCP(CP_UTF8);
    SetConsoleCP(CP_UTF8);
#endif

    std::cout << "开始测试三个库的功能..." << std::endl;

    bool allTestsPassed = true;

    // 测试各个库
    allTestsPassed &= testOpenCV();
    allTestsPassed &= testLibCurl();
    allTestsPassed &= testJsonCpp();

    // 综合测试
    allTestsPassed &= integratedTest();

    std::cout << "\n=== 测试结果 ===" << std::endl;
    if(allTestsPassed) {
        std::cout << "✓ 所有测试通过! 三个库都能正常工作。" << std::endl;
    } else {
        std::cout << "✗ 部分测试失败，请检查库的配置。" << std::endl;
    }

    std::cout << "\n按回车键退出..." << std::endl;
    std::cin.get();

    return allTestsPassed ? 0 : 1;
}
